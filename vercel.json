{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/read-with-me",
      "destination": "/read-with-me.html"
    },
    {
      "source": "/notes/:slug",
      "destination": "/notes/:slug.html"
    },
    {
      "source": "/articles/:slug",
      "destination": "/articles/:slug.html"
    },
    {
      "source": "/((?!articles|notes|read-with-me|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
